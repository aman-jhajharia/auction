# ====================================================================
# MUQABLA 2026 BASKETBALL AUCTION — PRODUCTION ENVIRONMENT CONFIGURATION
# ====================================================================
# Copy this file to .env and configure values before starting in production:
# cp .env.example .env
# ====================================================================

# Environment mode ('production' or 'development')
NODE_ENV=production

# Server Listen Port (Reverse proxy will route https://your-domain.com here)
PORT=4000

# JSON Web Token Secret (CRITICAL: Replace with a random 64-character string)
# Generate one using: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_64_character_cryptographic_secret
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (Comma-separated list of your production domains)
# Example: https://muqabla.youruniversity.edu or https://auction.your-domain.com
CORS_ORIGIN=https://your-domain.com,https://auction.your-domain.com
FRONTEND_ORIGIN=https://your-domain.com

# Persistent SQLite Database Location (outside build directory)
DATABASE_PATH=./data/auction.db

# Administrator Credentials (Optional: if left blank, random secure password is generated on seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public Display / Screen Credentials (Optional: if left blank, random secure password is generated on seed)
DISPLAY_USERNAME=display
DISPLAY_PASSWORD=

# Captain Password Overrides (Optional: if left blank, random secure 16-char passwords are generated on seed)
# CAPTAIN_ASHMIT_PASSWORD=
# CAPTAIN_VANSH_PASSWORD=
# CAPTAIN_DIVYANSHU_PASSWORD=
# CAPTAIN_CHIRAYU_PASSWORD=
# CAPTAIN_PARTH_PASSWORD=
