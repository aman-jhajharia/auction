# ====================================================================
# MUQABLA 2026 BASKETBALL AUCTION — ROOT ENVIRONMENT TEMPLATE
# ====================================================================

# Environment mode ('production' or 'development')
NODE_ENV=production

# Server Listen Port
PORT=4000

# Managed PostgreSQL Connection String
DATABASE_URL=postgres://user:password@hostname:5432/muqabla_auction
DATABASE_SSL=true

# JSON Web Token Secret (CRITICAL: Required in production. Minimum 32 chars)
# Generate via: openssl rand -hex 32
JWT_SECRET=your_production_64_character_hex_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (Vercel Frontend URL)
FRONTEND_ORIGIN=https://muqabla-auction.vercel.app
CORS_ORIGIN=https://muqabla-auction.vercel.app

# Frontend Variables (Used when running client build or dev)
VITE_API_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=https://your-backend.onrender.com
