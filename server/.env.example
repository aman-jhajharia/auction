# ====================================================================
# MUQABLA 2026 BASKETBALL AUCTION — BACKEND ENVIRONMENT (RENDER)
# ====================================================================

# Environment mode ('production' or 'development')
NODE_ENV=production

# Server Listen Port (Render provides $PORT automatically)
PORT=4000

# Managed PostgreSQL Database Connection String (Render / Supabase / Neon)
# Format: postgres://username:password@hostname:5432/dbname
DATABASE_URL=postgres://user:password@hostname:5432/muqabla_auction

# Set to 'false' only if your database does not use TLS/SSL
DATABASE_SSL=true

# JSON Web Token Secret (CRITICAL: Required in production. Minimum 32 chars)
# Generate via: openssl rand -hex 32
JWT_SECRET=your_production_64_character_hex_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Production Frontend Origin (Vercel URL or Custom Domain)
# Exact origin without trailing slash (e.g. https://muqabla2026.vercel.app)
FRONTEND_ORIGIN=https://muqabla-auction.vercel.app
CORS_ORIGIN=https://muqabla-auction.vercel.app

# Optional initial seed credentials (if omitted, high-entropy passwords generated on seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DISPLAY_USERNAME=display
DISPLAY_PASSWORD=
# CAPTAIN_ASHMIT_PASSWORD=
# CAPTAIN_VANSH_PASSWORD=
# CAPTAIN_DIVYANSHU_PASSWORD=
# CAPTAIN_CHIRAYU_PASSWORD=
# CAPTAIN_PARTH_PASSWORD=
